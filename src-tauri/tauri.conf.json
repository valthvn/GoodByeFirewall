{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoodByeFirewall",
  "version": "1.0.1",
  "identifier": "com.goodbyefirewall.desktop",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GoodByeFirewall",
        "url": "index.html",
        "width": 480,
        "height": 750,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": true
      },
      {
        "label": "tray",
        "title": "GoodByeFirewall Menu",
        "url": "tray.html",
        "width": 300,
        "height": 280,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": { "installMode": "perMachine" }
    },
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../WebView2Loader.dll": "WebView2Loader.dll",
      "../BinTools/": "BinTools/",
      "../assets/": "assets/"
    }
  }
}
